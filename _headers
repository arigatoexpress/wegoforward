# Fictional offline demos. Stricter than the marketing policy: no connections, no
# form posts, no analytics beacon. /demos covers the no-trailing-slash URL; /demos/*
# covers /demos/ and everything under it, so /demos/ needs no rule of its own.
/demos
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'

/demos/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'

/assets/*
  Cache-Control: public, max-age=604800

# Browsers request /favicon.ico by path. Content-Type only: shared security headers stay on /*.
/favicon.ico
  Content-Type: image/x-icon

# Plain-text index for agents. Content-Type only: shared security headers stay on /*.
/llms.txt
  Content-Type: text/plain; charset=utf-8
